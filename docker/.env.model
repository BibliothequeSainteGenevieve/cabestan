# Name of project, prefix for all services name
COMPOSE_PROJECT_NAME=cabestan
DJANGO_SUPERUSER_USERNAME=cabestan
DJANGO_SUPERUSER_EMAIL=cabestan@cabestan.com
DJANGO_SUPERUSER_PASSWORD=cabestan
# Local directory database storage
VOLUME_PGDATA=/path/to/db/cabestan
# Database information
DB_NAME=cabestan
DB_USER=cabestan
DB_PASSWORD=mypassword
DB_HOST=cabestan_db
# Exposed port (if you want to use psql client from host)
DB_PORT=5433

# These variables should not be touched
USER_ID=1000
GROUP_ID=1000
CABESTAN_ENV=DEV

# Should be Git root
WORK_DIR=..

# Hosts allowed (Django)
ALLOWED_HOSTS=servogne.com,cabestan,cabestan:8080,localhost
HOST=localhost

# Useful only if traefik is not enabled
# But MUST point valid certificates, or nginx will not run properly
# Path is host-based
CERTIFICATES_PATH=.

# Exposed ports
DJANGO_HTTP_PORT=8080
DJANGO_HTTPS_PORT=8443

CLIENT_HTTP_PORT=5173
CLIENT_HTTPS_PORT=0


SECRET_KEY='INSERT YOUR DJANGO SECRET KEY HERE'
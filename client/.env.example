# Copy this file to `.env` (or `.env.local`) and fill in the values.
# Only variables prefixed with VITE_ are exposed to the client bundle,
# and they are inlined at build time (`npm run build`).

# Backend API location
VITE_API_PROTOCOL=http
VITE_API_HOST=localhost
VITE_API_PATH=/api/rest

# React Query cache TTL (ms)
VITE_CACHE_TTL=1000

# CARTO Basemaps API key — required for the map tiles.
# Get a free key at https://carto.com/basemaps/apikey/
# Without it, CARTO serves tiles stamped "API KEY REQUIRED".
VITE_CARTO_API_KEY=

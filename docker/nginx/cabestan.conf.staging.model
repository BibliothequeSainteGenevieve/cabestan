server {
    listen 80;
    listen [::]:80;

    server_name  '${HOST}';
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${HOST}$request_uri;
    }
}


server {
    listen 443 default_server ssl;
    listen [::]:443 ssl;
    server_name  '${HOST}';
    root         /var/www/html/;
    index        index.html;

    ssl_certificate /etc/nginx/ssl/live/${HOST}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/${HOST}/privkey.pem;

    # Tout le reste géré par Django
    location /api {
        proxy_read_timeout 600;
        proxy_redirect off; 
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;        
        proxy_pass http://cabestan:${DJANGO_HTTP_PORT};
    }

     # Tout le reste géré par Django
    location /admin {
        proxy_read_timeout 600;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;        
        proxy_pass http://cabestan:${DJANGO_HTTP_PORT};
    }

    location /static {
        proxy_read_timeout 600;
        proxy_redirect off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;        
        proxy_pass http://cabestan:${DJANGO_HTTP_PORT};
    }

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
        location = /static/404.html {
    }

    error_page 503 /503.html;
      location = /static/503.html {
    }

    error_page 502 /502.html;
      location = /static/502.html {
    }

    error_page 500 502 504 /50x.html;
        location = /50x.html {
    }
}
